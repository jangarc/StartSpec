{
  "name": "iam-frontend-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && stylelint packages/components/src/styles/*.css packages/theme/src/*.css apps/*/src/**/*.css --ignore-path .gitignore --allow-empty-input --config stylelint.config.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "stylelint": "^16.26.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.71.2"
  }
}
