        <mxCell id="person_1_label" value="&lt;b&gt;Product Team（商品團隊）&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;使用 HQ API 進行管理作業。&lt;/font&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1">
